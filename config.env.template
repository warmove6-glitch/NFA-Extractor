# ================================================================================
# NFA EXTRACTOR - CONFIGURATION TEMPLATE
# ================================================================================
# Copie este arquivo para `config.env` e preencha os valores reais.
# NUNCA commite `config.env` (já está no .gitignore).
# ================================================================================

# ─── DATABASE ──────────────────────────────────────────────────────────────────
# Use senha forte (>= 16 chars, gerada aleatoriamente)
DATABASE_URL=postgresql://nfa_user:CHANGE_ME_STRONG_RANDOM_PASSWORD@localhost:5432/nfa_extractor

# ─── AI / LLM API KEYS ─────────────────────────────────────────────────────────
# Obtenha em https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Obtenha em https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── ms-swift (motor local principal — 100% offline) ───────────────────────────
# Inicie com: swift deploy --model Qwen/Qwen2.5-7B-Instruct --infer_backend vllm
# Para CPU (sem GPU): swift deploy --model Qwen/Qwen2.5-3B-Instruct --infer_backend pt
SWIFT_URL=http://localhost:8000/v1
SWIFT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Ollama (local - fallback secundário)
OLLAMA_HOST=http://localhost:11434

# ─── JWT (Autenticação) ────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_USE_SECRETS_TOKEN_URLSAFE_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── REPORT SETTINGS ───────────────────────────────────────────────────────────
REPORT_LANG=pt_BR
REPORT_THEME=dark_mode
CHART_DPI=300

# ─── LOGGING ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=extractor.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ─── APPLICATION ───────────────────────────────────────────────────────────────
DEBUG=False
APP_NAME=OrgAudi NFA Extractor
APP_VERSION=2.0.0

# ─── POSTGRES (docker-compose) ─────────────────────────────────────────────────
# Usado pelo docker-compose.yml; mantenha em sincronia com DATABASE_URL acima
POSTGRES_USER=nfa_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
POSTGRES_DB=nfa_extractor
