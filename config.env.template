# ================================================================================
# NFA EXTRACTOR - CONFIGURATION TEMPLATE
# ================================================================================
# Copy this file to config.env (or .env) and fill in your values
# NEVER commit config.env or .env to git!
# ================================================================================

# JWT SECURITY (OBRIGATÓRIO - mínimo 32 caracteres)
# ==================================================
# Gere com: openssl rand -hex 32
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ADMIN BOOTSTRAP (apenas para o primeiro deploy)
# ==================================================
# Após o admin ser criado, REMOVA estas envs e desabilite POST /auth/seed.
# - SEED_BOOTSTRAP_TOKEN: token aleatório enviado no header X-Seed-Token
#   (gere com: openssl rand -hex 24)
# - ADMIN_INITIAL_PASSWORD: senha do admin inicial (mín 12 caracteres)
SEED_BOOTSTRAP_TOKEN=
ADMIN_EMAIL=admin@orgatec.com.br
ADMIN_INITIAL_PASSWORD=

# DATABASE CONFIGURATION
# ======================
DATABASE_URL=postgresql://nfa_user:YOUR_PASSWORD@localhost:5432/nfa_extractor

# DOCKER POSTGRES (usado pelo docker-compose)
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=nfa_extractor

# SUPABASE (Orgatec-data — tabelas financeiras)
# =============================================
# Encontre em: Dashboard → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# AI/LLM API KEYS (opcionais — Ollama local é prioridade)
# ========================================================
# Anthropic Claude (opt-in)
ANTHROPIC_API_KEY=

# Google Gemini (opt-in)
GOOGLE_API_KEY=

# Ollama (local - sem chave necessária)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# REPORT SETTINGS
# ===============
REPORT_LANG=pt_BR
REPORT_THEME=dark_mode
CHART_DPI=300

# LOGGING
# =======
LOG_LEVEL=INFO
LOG_FILE=extractor.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# APPLICATION
# ===========
DEBUG=False
APP_NAME=OrgAudi NFA Extractor
APP_VERSION=7.2.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
