# ================================================================================
# NFA Extractor - .gitignore
# ================================================================================

# ─── Segredos e credenciais ────────────────────────────────────────────────────
.env
.env.*
.env.local
!.env.example
!.env.*.example
config.env
*.pem
*.key
*.p12
*.pfx
credentials.json
id_rsa

# ─── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# ─── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
.next/
dist/
build/
coverage/
frontend/.vite/

# ─── Editores / IDEs ───────────────────────────────────────────────────────────
.idea/
.vscode/
.cursor/
.claude/
.uix/

# ─── Artefatos locais ──────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.pkl
*.joblib
*.log
tmp/
.cache/

# ─── Outputs gerados ───────────────────────────────────────────────────────────
relatorios/
data/laudos/
*.xlsx
!src/**/*.xlsx
extractor.log

# ─── OS ────────────────────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
